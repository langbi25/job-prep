.env
deploy/**/.env.langfuse
data/kb.sqlite
data/app.db
data/job_prep.sqlite3
# SQLite 运行时伴随文件与 job 文件锁：都是进程活着的证据，重启就变，不该进版本库
data/*.sqlite-wal
data/*.sqlite-shm
data/*.sqlite-journal
data/*.lock
data/tool_flags.json
data/_backup/
data/_tmp_live/
backups/
docker-build.log
uvicorn-*.log
__pycache__/
.venv/
reports/
.eval-artifacts/
node_modules/

# IDE
.idea/

# 外部 MCP server 配置（含本机绝对路径，不提交；样例见 mcp_servers.example.json）
mcp_servers.json

# pytest 临时目录（--basetemp 指定在仓库内，避免 Windows 清理失败）
.pytest_tmp/
