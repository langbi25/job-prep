# 后端端口（避免与其他项目冲突，默认 8765）
APP_PORT=8765

# API 访问令牌：拦 /api/*，/health 与前端静态页放行，空 = 关闭（本地脚本零开销）。
# curl/脚本带 X-API-Token 或 Authorization: Bearer；浏览器首次访问弹框输入一次。
# APP_TOKEN=change-me-please

# CORS 白名单（逗号分隔，默认本机 8765/5173，一般不用改）
# CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765

# 面经抽取 / 卡片打标使用的 LLM（OpenAI 兼容协议）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- Trace 采集（可选）：TRACING_ENDPOINT 留空则完全关闭，测试/评测零开销 ----
# OBS_BACKEND 决定「中文可观测面板」读哪个数据源：phoenix | langfuse
OBS_BACKEND=phoenix
TRACING_SERVICE=job-prep
TRACING_FLUSH_MS=5000

# 方案一：Phoenix（pip 起，单进程 + SQLite，本机无需 Docker）
#   启动：PHOENIX_HOST=127.0.0.1 PHOENIX_PORT=6006 python -m phoenix.server.main serve
TRACING_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_URL=http://127.0.0.1:6006

# 方案二：Langfuse 自托管（deploy/langfuse/docker-compose.yml，需 Docker + WSL2）
#   1) docker network create obs
#   2) docker compose -f deploy/langfuse/docker-compose.yml --env-file deploy/langfuse/.env.langfuse up -d
#   3) http://localhost:3000 注册 → 建 Project → Settings → API Keys
#   4) base64: echo -n "pk-lf-xxx:sk-lf-xxx" | base64
# TRACING_ENDPOINT=http://localhost:3000/api/public/otel
# TRACING_HEADERS=Authorization=Basic <base64>;x-langfuse-ingestion-version=4
# LANGFUSE_URL=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx

# ---- Langfuse 双写（OTLP）。URL 用 compose 服务名（api 容器内 localhost 指容器自己）；
# Authorization 是 pk:sk 的 base64。先起 deploy/langfuse 的 compose。
# TRACING_ENDPOINT=http://langfuse-web:3000/api/public/otel
# TRACING_HEADERS=Authorization=Basic <base64(pk:sk)>
# TRACING_FLUSH_MS=2000
# OBS_BACKEND=langfuse

# ---- 可观测告警（app/observability/alerts.py）----
# 错误率 / 慢调用超阈值 → webhook 推送。判定数据源是本地 spans 表（观测后端挂了照常工作）。
# WEBHOOK 空 = 告警关闭（不启动后台循环，零开销）；format 支持 generic|wecom|dingtalk。
# 配好后先用 POST /api/obs/alerts/test 验收链路，不必等真故障。
# ALERT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# ALERT_FORMAT=wecom
# ALERT_CHECK_SEC=60          # 后台检查间隔；0=不启动
# ALERT_WINDOW_MIN=5          # 滚动窗口
# ALERT_MIN_CALLS=10          # 窗口内顶层调用少于这个数不判错误率（样本太小）
# ALERT_ERROR_RATE=0.5        # 错误率阈值
# ALERT_SLOW_MS=10000         # 慢调用线
# ALERT_SLOW_COUNT=3          # 窗口内慢调用达到几次触发
# ALERT_COOLDOWN_MIN=30       # 同一条规则的冷却期

# ---- LLM 上游并发池（app/core/llm.py）----
# 编排并行 + 记忆抽取 + 主对话共用一个池；超出排队，等不到快速失败（retryable）。
# LLM_MAX_CONCURRENCY=4
# LLM_ACQUIRE_TIMEOUT=30      # 排队上限秒数

# ---- MCP HTTP 接入（可选，默认不启动）----
# 让 Claude Desktop / Cursor 这类外部客户端远程接本机知识库。
# 启用步骤：
#   1) 生成 token 并写进 .env：  python -c "import secrets;print('MCP_TOKEN='+secrets.token_urlsafe(32))" >> .env
#   2) 启动：  docker compose --profile mcp up -d
#   3) 客户端填 http://127.0.0.1:8766/mcp，Header: Authorization: Bearer <上面的 token>
# 不设 MCP_TOKEN 时服务会主动退出——绑定非本地地址必须有 token，宁可起不来也不要裸奔。
# 端口只映射到宿主的 127.0.0.1，外部网络访问不到。
# MCP_TOKEN=
